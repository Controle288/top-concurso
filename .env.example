# === SUPABASE (OBRIGATÓRIO) ===
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sua_anon_key_aqui

# === YOUTUBE API (OPCIONAL — para importar vídeos em massa no admin) ===
# Sem essa chave, o admin adiciona aulas manualmente colando o link do YouTube.
# Crie uma chave em: https://console.cloud.google.com/apis/credentials
# Ative a "YouTube Data API v3" no Google Cloud Console
# VITE_YOUTUBE_API_KEY=sua_chave_youtube_aqui

# === STRIPE (OPCIONAL — para assinaturas) ===
# Chave pública do Stripe (começa com pk_)
# https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# === NOTIFICAÇÕES PUSH (OPCIONAL) ===
# Gerar com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
